{
  "name": "retifica-mendonca-local",
  "productName": "Retífica Mendonça LOCAL",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "set NODE_OPTIONS=\"--max-old-space-size=4096\" && next dev -p 3210",
    "build": "next build",
    "start": "next start -p 3210",
    "desktop": "concurrently \"npm run dev\" \"wait-on http://localhost:3210 && electron .\"",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@google/genai": "^1.17.0",
    "@hookform/resolvers": "^5.2.1",
    "@types/react-window": "^1.8.8",
    "autoprefixer": "^10.4.21",
    "better-sqlite3": "^12.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.2.1",
    "lucide-react": "^0.474.0",
    "motion": "^12.23.24",
    "next": "^15.4.9",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.6",
    "react": "^19.2.1",
    "react-day-picker": "^10.0.0",
    "react-dom": "^19.2.1",
    "react-hook-form": "^7.54.2",
    "react-window": "^2.2.7",
    "shadcn": "^4.7.0",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.11",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "electron": "^31.0.0",
    "electron-builder": "^26.8.1",
    "eslint": "9.39.1",
    "eslint-config-next": "16.0.8",
    "tailwindcss": "4.1.11",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.retifica.mendonca.local",
    "productName": "Retífica Mendonça LOCAL",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Retífica Mendonça LOCAL (Testes)",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    }
  }
}
